# Partial-warp SHUF boundary fallback, VOTE, and MTCH equivalence masks.
CPY.u32 R1, %laneid
LOADI R2, 1
AND.u32 R3, R1, R2
LOADI R4, 0
CMPP.eq.u32 P1, R3, R4
SHUF.up.u32 R10, R1, 1, 0x000fffff
SHUF.down.u32 R11, R1, 1, 0x000fffff
SHUF.bfly.u32 R12, R1, 1, 0x000fffff
VOTE.all R13, P1
VOTE.any R14, P1
VOTE.uni R15, P1
MTCH.any R16, R3
LOADI R40, 28
MUL.u32 R41, R1, R40
LOADI R42, 0x100
ADD.u32 R43, R42, R41
LOADI R44, 4
ST.gmem.u32 [R43], R10
ADD.u32 R43, R43, R44
ST.gmem.u32 [R43], R11
ADD.u32 R43, R43, R44
ST.gmem.u32 [R43], R12
ADD.u32 R43, R43, R44
ST.gmem.u32 [R43], R13
ADD.u32 R43, R43, R44
ST.gmem.u32 [R43], R14
ADD.u32 R43, R43, R44
ST.gmem.u32 [R43], R15
ADD.u32 R43, R43, R44
ST.gmem.u32 [R43], R16
HALT
