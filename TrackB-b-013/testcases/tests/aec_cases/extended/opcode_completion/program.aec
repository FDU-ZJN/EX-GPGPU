# Every formerly absent opcode, with independent exact results.
LOADI R50, 0x100
LOADI R51, 4
LOADI R10, 0x00000007
LOADI R11, 0x00000003
LOADI R12, 0xfffffffb
LOADI R13, 0x0f0f00ff
LOADI R14, 0x3333ff00
LOADI R15, 0xffff0000
LOADI R16, 0x0000005a
SUB.u32 R20, R10, R11
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
NEG.s32 R20, R12
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
ABS.s32 R20, R12
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
OR.b32 R20, R13, R14
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
XOR.b32 R20, R13, R14
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
NOT.b32 R20, R13
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
BINS.b32 R20, R15, R16, 8, 8
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
FLO.b32 R20, R0
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
LOADI R17, 0x80000001
FLO.u32 R20, R17
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
PICK.u32 R20, R13, R14
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
LOADI R17, 0xf0000001
PICK.s32 R20, R17, R14
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
BR br_taken
LOADI R20, 0xdeadbeef
br_taken: LOADI R20, 0x12345678
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
LOADI R17, 0x00000080
CVTII.s8.u32 R20, R17
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
LOADI R17, 0x00000000
COS.f32 R20, R17
ST.gmem.u32 [R50], R20
ADD.u32 R50, R50, R51
HALT
