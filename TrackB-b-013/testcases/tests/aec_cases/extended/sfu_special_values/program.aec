# SFU special-value rules are exact even though normal results use ULP bounds.
CPY.u32 R1, %laneid
LOADI R10, 0x00000000
LOADI R11, 0x80000000
LOADI R12, 0xbf800000
LOADI R13, 0x7f800000
LOADI R14, 0xff800000
RCP.full.f32 R20, R10
RCP.full.f32 R21, R11
RSQ.full.f32 R22, R12
SQRT.full.f32 R23, R11
SQRT.full.f32 R24, R12
SIN.f32 R25, R13
LOG.f32 R26, R10
EXP.f32 R27, R14
LOADI R40, 32
MUL.u32 R41, R1, R40
LOADI R42, 0x100
ADD.u32 R43, R42, R41
LOADI R44, 4
ST.gmem.u32 [R43], R20
ADD.u32 R43, R43, R44
ST.gmem.u32 [R43], R21
ADD.u32 R43, R43, R44
ST.gmem.u32 [R43], R22
ADD.u32 R43, R43, R44
ST.gmem.u32 [R43], R23
ADD.u32 R43, R43, R44
ST.gmem.u32 [R43], R24
ADD.u32 R43, R43, R44
ST.gmem.u32 [R43], R25
ADD.u32 R43, R43, R44
ST.gmem.u32 [R43], R26
ADD.u32 R43, R43, R44
ST.gmem.u32 [R43], R27
HALT
